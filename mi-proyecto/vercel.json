{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://your-project.supabase.co/functions/v1/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Authorization",
          "value": "Bearer YOUR_SUPABASE_ANON_KEY"
        }
      ]
    }
  ]
}